{{- $pages := .RegularPages -}}
{{- if .IsHome -}}
  {{- $pages = (site.GetPage "/posts").RegularPagesRecursive -}}
{{- else if eq .Kind "section" -}}
  {{- $pages = .RegularPagesRecursive -}}
{{- end -}}
{{- $posts := partial "preferred-posts.html" (dict "pages" $pages "language" site.Language.Name) -}}
{{- "<?xml version=\"1.0\" encoding=\"utf-8\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ if not .IsHome }}{{ .Title }} · {{ end }}{{ site.Title }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ .Description | default site.Params.description }}</description>
    <language>{{ site.Language.Locale }}</language>
    {{ with .OutputFormats.Get "rss" }}<atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml" />{{ end }}
    {{ range $posts }}
      <item>
        <title>{{ .Title }}</title>
        <link>{{ .Permalink }}</link>
        <guid isPermaLink="true">{{ .Permalink }}</guid>
        {{ if not .Date.IsZero }}<pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>{{ end }}
        <description>{{ .Description | default (.Summary | plainify) }}</description>
      </item>
    {{ end }}
  </channel>
</rss>
